# OpenRouter API Key (for LLM and embeddings)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# CORS origins (comma-separated, no quotes)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# SQLite checkpointer path (for conversation persistence)
# SQLITE_DB_PATH=db/checkpoints.db

# Optional: Other API keys for future expansion
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_google_key_here
