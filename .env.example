# OpenRouter API Key (for LLM and embeddings)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# CORS origins (comma-separated, no quotes)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name (default: b-rag)
# MONGODB_DATABASE=b-rag

# Authentication (shared secret matching frontend AUTH_SECRET for JWT verification)
# AUTH_SECRET=your_shared_secret_here

# When false, bypasses JWT verification (returns mock admin user)
# AUTH_ENABLED=true

# Optional: Other API keys for future expansion
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_google_key_here
